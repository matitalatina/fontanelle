DATABASE_URL="file:db/db.db"

# OpenStreetMap OAuth2 credentials
# Register an application at https://www.openstreetmap.org/oauth2/applications/new
# with scopes "write_api" and "read_prefs" (confidential app) and add these redirect URIs:
#   http://127.0.0.1:3000/api/v1/osm/auth/callback   (local development)
#   https://fontanelleitalia.com/api/v1/osm/auth/callback (production)
OSM_CLIENT_ID=""
OSM_CLIENT_SECRET=""

# Point this to the OSM development instance to test without touching real map data:
# https://master.apis.dev.openstreetmap.org (requires a separate account + app registration)
OSM_SERVER_URL="https://www.openstreetmap.org"

# Canonical public origin of this app. The OAuth flow (login cookies + redirect URI)
# is always forced onto this host, so you can browse the app from any address
# (localhost, 127.0.0.1, a LAN IP) and still log in successfully.
# Note: OAuth cookies are always HttpOnly + Secure; local testing must therefore use
# https or localhost/127.0.0.1 (both are exempt from the Secure restriction by browsers).
APP_ORIGIN="http://127.0.0.1:3000"
